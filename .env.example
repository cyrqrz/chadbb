# Copie para .env.local. Use os valores públicos exibidos por npm run db:start.
# Sem estas variáveis, a aplicação mostra apenas a página inicial.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Nunca coloque service_role, chave secreta, senha do banco ou tokens em VITE_*.

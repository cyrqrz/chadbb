{
  "name": "chadbb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "test:db:portable": "node --test tests/database/*.integration.mjs",
    "test:e2e": "playwright test",
    "test:api": "node --test --test-concurrency=1 tests/api/*.integration.mjs",
    "test:browser:local": "node --test tests/browser/*.integration.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/functions/local-test.env",
    "test:email:local": "node --test tests/local/email-login.test.mjs",
    "test:load:local": "node tests/load/guest.mjs",
    "test:recovery:local": "node tests/recovery/rehearsal.mjs",
    "test:recovery:archive": "node tests/recovery/archive.mjs",
    "backup:remote": "node scripts/backup/remote.mjs",
    "test:smoke:remote": "node --test tests/remote/smoke.mjs",
    "health:remote": "node scripts/health/check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

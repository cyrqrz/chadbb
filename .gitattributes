# Normaliza fim de linha: o repositório guarda LF e a árvore de trabalho usa LF.
# Evita que edições no Windows/WSL gerem diffs de arquivo inteiro.
* text=auto eol=lf

# Scripts e SQL dependem de LF ao rodar em Linux/CI.
*.sh text eol=lf
*.sql text eol=lf

# Binários não passam por conversão de fim de linha.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.xz binary
*.tar binary

# Lockfile: gerado por ferramenta, não precisa aparecer nos diffs de revisão.
package-lock.json -diff linguist-generated
